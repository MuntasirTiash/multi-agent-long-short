# Python
__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints/

# SLURM / server stdout — large, machine-specific, regenerated every run.
# The graded results (results/*.json, *.csv, *.jsonl) ARE tracked.
# Note the ** : per-run logs live in results/{run_tag}/run.log, so a bare
# results/*.log would miss them.
results/**/*.log
slurm-*.out

# Oversized transcripts from 498-name runs. Every other transcript.jsonl is
# tracked as usual; these are excluded by size, not by kind. The two 220 MB
# files are over GitHub's 100 MB hard cap and would have the push rejected.
# A 498-agent multi-round run emits ~220 MB of transcript, so check the size of
# any new full-universe run before staging it and add it here if it is large.
results/daily_20260729_205051_rule-based_full-sparse-sector/transcript.jsonl
results/transcript_sparse-sector-corr_topk_498x32.jsonl
results/daily_20260730_023813_LLM-transformers_sparse-sector-corr_topk/transcript.jsonl

# Claude Code: local-only settings and nested git worktrees of this repo.
.claude/settings.local.json
.claude/worktrees/

